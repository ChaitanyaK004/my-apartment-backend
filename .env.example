# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5001

# Atlas -> your cluster -> Connect -> Drivers -> copy the string, then replace
# <db_username> and <db_password> with your Database Access user.
# If the password has special characters (@ : / ? # %), URL-encode them (@ becomes %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/

DB_NAME=My-Apartment

# true = print every database query in this terminal (good for learning/demo)
DEBUG_DB=true

# Website addresses allowed to call the API, comma separated (any http://localhost:<port> is already allowed).
# Add your LAN address for phone testing and your production site, e.g.
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.20:5173,https://myapartment.example.com
CLIENT_ORIGIN=http://localhost:5173

# Login security. Change JWT_SECRET to any long random text (also signs sessions opened from the mobile app).
JWT_SECRET=change-this-to-a-long-random-text

# Fixed admin account (created by: npm run seed-users). Change the password before you put the site online.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@myapartment.com
ADMIN_PASSWORD=Admin@123
